{
  "servers": [
    {
      "name": "mcp-server-filesystem",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/data/projects"
      ]
    },
    {
      "name": "mcp-server-github",
      "url": "https://api.githubcopilot.com",
      "endpoint": "mcp",
      "headers": {
        "Authorization": "Bearer <token>"
      }
    }
  ]
}